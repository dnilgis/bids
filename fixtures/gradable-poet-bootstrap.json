a", "smartystreets_normalized_addresses": {"city_name": null, "time_zone": null, "address_id": null, "plus4_code": null, "county_name": null, "postal_code": null, "street_name": null, "street_suffix": null, "primary_number": null, "secondary_number": null, "state_abbreviation": null, "street_predirection": null, "secondary_designator": null, "street_postdirection": null}}, "company": "POET Grain", "ext_ids": ["PGCPOR"], "contacts": [{"id": "u_02f5198759891c5e", "email": "clay.ebbinghouse@poet.com", "lastname": "Ebbinghouse", "firstname": "Clayton", "phone_number": "+12607297257"}, {"id": "u_39c9449b4a00feaf", "email": "audrey.muhlenkamp@poet.com", "lastname": "Muhlenkamp", "firstname": "Audrey", "phone_number": "+12607298214"}], "url_paths": [{"url_path": "/Portland--IN", "is_current": true}], "crop_years": {}, "demo_market": false, "market_meta": {}, "display_name": "Portland, IN", "office_hours": {"hours": [{"end": "16:00", "date": "2026-09-07", "start": "07:30"}, {"end": "16:00", "date": "2026-09-08", "start": "07:30"}, {"end": "16:00", "date": "2026-09-09", "start": "07:30"}, {"end": "16:00", "date": "2026-09-10", "start": "07:30"}, {"end": "16:00", "date": "2026-09-11", "start": "07:30"}, {"date": "2026-09-12", "closed": true, "hours_state": "closed"}, {"date": "2026-09-13", "closed": true, "hours_state": "closed"}, {"end": "16:00", "date": "2026-09-14", "start": "07:30"}], "timezone": {"name": "America/New_York"}}, "announcements": [{"id": 6074, "date": "2026-04-08", "title": "Portland DP", "content": {"type": "text/plain", "value": "DP is free through 8/31/2026. Must be priced by 8/31/26 per state law. Offering will end when a limited target number of bushels have been delivered."}, "highlighted": false}, {"id": 6879, "date": "2026-09-02", "title": "Looking for Trucking", "content": {"type": "text/plain", "value": "We are looking for commercial trucks to haul corn from Emporia, IN (by Anderson) to Portland.\nGive us a call for details: 866-718-2676"}, "highlighted": true}], "delivery_info": {"notice": {"type": "text/plain", "value": "New accounts: Call ahead to 260-726-1430 to provide names, addresses, phone numbers & email addresses & any ticket splits. Scan cards will be issued while you're on the inbound scale on your first visit.\n\nMoisture: Will accept up to 20%, and limited amounts up to 25%. Starting Sept 22: Discount is 1.5 cents/half point starting at 15.6, plus 0.7% shrink per 1/2 point starting at 15.1. \n\nCorn delivered without a contract or \"for sale\" will be priced at our nearby daily CLOSING price.\n\nDelayed Pricing - Starting 12/1 - No charge through Jan 2. Then 5 cents/month pro-rated daily. Must be priced by 8/31/2026, per Indiana state law.\n\nCorn checks are issued each Tues & Thus.\n\nGrain hours are subject to change with customer demand and weather.\n\nDry Distillers Grains Loading Mon - Fri, 7 AM - 4:00 PM\nCorn Oil Loading Mon - Fri, 7 AM - 3:30 PM\nWet Cake Loading 7 days a week, 24 hours a day\nEthanol Loading 7 days a week, 24 hours a day\n"}, "scale_hours": {"hours": [{"date": "2026-09-07", "closed": true, "hours_state": "closed"}, {"end": "16:00", "date": "2026-09-08", "start": "07:00"}, {"end": "16:00", "date": "2026-09-09", "start": "07:00"}, {"end": "16:00", "date": "2026-09-10", "start": "07:00"}, {"end": "16:00", "date": "2026-09-11", "start": "07:00"}, {"date": "2026-09-12", "closed": true, "hours_state": "closed"}, {"date": "2026-09-13", "closed": true, "hours_state": "closed"}, {"end": "16:00", "date": "2026-09-14", "start": "07:00"}], "timezone": {"name": "America/New_York"}}, "phone_number": "8667182676"}, "phone_numbers": [], "user_permissions": [], "commodity_settings": {"1": {"cash_rounding_mode": "half_down"}}, "bids_offers_enabled": true, "farmer_offers_enabled": true, "public_offers_enabled": false, "num_public_instruments": 70, "sustainability_enabled": {}, "promote_farmer_on_boarding": true, "enable_gradable_public_site": true}, {"id": 331847126, "urls": [{"url": "htt