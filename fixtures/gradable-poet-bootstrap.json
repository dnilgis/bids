s": [{"id": 2316, "date": "2024-07-19", "title": "Canadian Clean Fuel Requirements (CFR)", "content": {"type": "text/plain", "value": "Help us continue our export program for ethanol to Canada. We need to track that our corn is sourced in the USA. In our APP go to the Sustainability tab and fill out the POET Canadian Clean Fuel Regulation Harvester Declaration. All we need is your farm address to track those bushels. If you have multiple accounts or need help, please call the office 605-409-1240. See below for link to program."}, "highlighted": false}, {"id": 3557, "date": "2025-03-25", "title": "Phone Numbers", "content": {"type": "text/plain", "value": "Phone numbers for Chancellor:\nGrain Line (605) 409-1240\nJen Bertrand (605) 409-1232\nTravis Parsons (605) 409-1219\nBranstyn Peterson (605) 409-1293\nTyronne Bialas (605) 409-1217"}, "highlighted": false}, {"id": 5641, "date": "2026-01-23", "title": "Morning Market Commentary", "content": {"type": "text/plain", "value": "Stay ahead of the markets. Call us today to receive exclusive morning commentary from our Poet analyst team!"}, "highlighted": false}, {"id": 5967, "date": "2026-03-27", "title": "Free DP", "content": {"type": "text/plain", "value": "Starting Monday Mar 30, 2026, we will offer free DP. Must be registered for Canadian CFR program before hauling. \nBushels must be priced on or before noon on September 15th, 2026 or the bushels will be automatically priced at the close of that day. \nTo sign up for DP or questions, please call Jen, Travis, Branstyn or Tyronne at 605-409-1240.\nSpace may be limited. "}, "highlighted": false}, {"id": 6524, "date": "2026-06-29", "title": "New Discount Schedule Effective July 1st, 2026", "content": {"type": "text/plain", "value": "Starting 07/01/26. New discount schedule will be in effect. Call us with questions! Link below or check our website https://webfiles.poetgrain.com/CHA/POET_Chancellor_Discount_Sch.pdf"}, "highlighted": false}, {"id": 6755, "date": "2026-08-10", "title": "One of our programs is back open.", "content": {"type": "text/plain", "value": "Earn more on your corn this fall.   One of our programs is back open - call 605-409-1240 and we'll walk you through the details!"}, "highlighted": false}, {"id": 6857, "date": "2026-08-31", "title": "Labor Day CLOSED", "content": {"type": "text/plain", "value": "We will be closed for corn receiving Monday, September 7th, for Labor Day. Thank you!"}, "highlighted": true}, {"id": 6865, "date": "2026-09-01", "title": "NO CORN RECEIVING THIS AFTERNOON", "content": {"type": "text/plain", "value": "ATTN: NO CORN RECEIVING THIS AFTERNOON, we will be shutting off at 12:00 PM noon. Thank you for your patience."}, "highlighted": false}], "delivery_info": {"notice": {"type": "text/plain", "value": "A NEW FEED SOLUTION:  MODIFIED DDGS\n*Recommended for ruminants\n*48% dry matter\n*Savings on freight costs\n*Consistent product\n*Reliable availability\nLEARN MORE AT:  DAKOTAGOLD.COM\nCall: 888-327-8799"}, "scale_hours": {"hours": [{"end": "17:30", "date": "2026-09-07", "start": "07:30"}, {"end": "17:30", "date": "2026-09-08", "start": "07:30"}, {"end": "17:30", "date": "2026-09-09", "start": "07:30"}, {"end": "17:30", "date": "2026-09-10", "start": "07:30"}, {"end": "17:30", "date": "2026-09-11", "start": "07:30"}, {"date": "2026-09-12", "closed": true, "hours_state": "closed"}, {"date": "2026-09-13", "closed": true, "hours_state": "closed"}, {"end": "17:30", "date": "2026-09-14", "start": "07:30"}], "timezone": {"name": "America/Chicago"}}, "phone_number": "8663029761"}, "phone_numbers": [], "user_permissions": [], "commodity_settings": {"1": {"cash_rounding_mode": "half_up"}}, "bids_offers_enabled": true, "farmer_offers_enabled": false, "public_offers_enabled": false, "num_public_instruments": 69, "sustainability_enabled": {}, "promote_farmer_on_boarding": true, "enable_gradable_public_site": true}, {"id": 331847705, "urls": [{"url": "https://webfiles.poetgrain.com/PGC/PGACHAuthorization