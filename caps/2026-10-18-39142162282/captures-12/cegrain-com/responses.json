background: #fff; } td[class*=\"options-widget\"] { white-space: nowrap; }';\n                                        container.appendChild(style);\n                                        const modal = document.getElementById('dtn-futures-options-6ad455de4577e-modal');\n                                        modal.addEventListener('scroll', () => {\n                                            container.querySelectorAll('th[class*=\"options-widget\"]').forEach(th => {\n                                                th.style.transform = 'translateY(' + modal.scrollTop + 'px)';\n                                            });\n                                        });\n                                    }\n                                };\n                                const applyDelayedLabel = () => {\n                                    const h1 = container.querySelector('div.commodity-title h1');\n                                    if (h1 && !h1.querySelector('.dtn-delayed-label')) {\n                                        const match = h1.textContent.match(/^(.*?)\\[(\\d+)\\](.*)$/);\n                                        if (match) {\n                                            h1.textContent = '';\n                                            h1.appendChild(document.createTextNode(match[1]));\n                                            const span = document.createElement('span');\n                                            span.style.color = '#838384';\n                                            span.style.fontSize = '0.60em';\n                                            span.textContent = '[' + match[2] + ' minute delayed]';\n                                            h1.appendChild(span);\n                                        }\n                                    }\n                                };\n                                const applyH1Align = () => container.querySelectorAll('h1[class*=\"options-widget\"]').forEach(h1 => {\n     