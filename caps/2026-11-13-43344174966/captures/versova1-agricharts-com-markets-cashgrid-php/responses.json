  "body": "<!DOCTYPE html PUBLIC \"-//W3C//DTD XHTML 1.0 Transitional//EN\" \"http://www.w3.org/TR/xhtml1/DTD/xhtml1-transitional.dtd\">\n<html xmlns=\"http://www.w3.org/1999/xhtml\" lang=\"en\">\n\t<head>\n\t\t\t\t<title>Versova Cash Bid JSI - Cash Bids</title>\n\t\t<!--[if IE & gte IE 8 ]>\n\t\t\t<meta http-equiv=\"x-ua-compatible\" content=\"IE=edge\">\n\t\t<![endif]-->\n\t\t<meta name=\"keywords\" content=\"\" />\n        <meta name=\"description\" content=\"\" />\n\t\t<!---->\n\t\t\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/symbolpicker.css\" />\n\t\t<link rel=\"shortcut icon\" href=\"\" />\n\t\t\t\t\t<link rel=\"stylesheet\" href=\"/css/layout.css\" type=\"text/css\" />\n\t\t\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/ac-timeline.css\" />\n\n\t\t\n\t\t<script type=\"text/javascript\" nonce=\"ac-sites-inline-js\">\n\t\t\tvar JSTemplateName = 'traditional';\n\t\t</script>\n\t\t\t\t\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/prototype/1.7.3/prototype.min.js\" integrity=\"sha512-C4LuwXQtQOF1iTRy3zwClYLsLgFLlG8nCV5dCxDjPcWsyFelQXzi3efHRjptsOzbHwwnXC3ZU+sWUh1gmxaTBA==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n\t\t\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/scriptaculous/1.9.0/scriptaculous.min.js\" integrity=\"sha512-74QwpT9VKUg4Ct+SL/ko7CRxUxP6xCGECFJ8tvJeOjv/lIaVuVmHj+0wOdB2nueamUmNT7i/YTrEI/hqPGDqZg==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n\t\t\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/scriptaculous/1.9.0/effects.min.js\" integrity=\"sha512-X0qkS1666/WH6PX1gp5piXLWt7D9zEjf5dRB8RDjUk22+1svCaQQ8CO9MRUItudZ7Gnc/BaCRrfYjD9xHUJh1w==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n\t\t\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/scriptaculous/1.9.0/controls.min.js\" integrity=\"sha512-rihXsA3ixGDst2qmEFGnWQNmyaNjEdntOnMk+fjjgUXjW+yD6Q/jsdcNGQvmTTWKY26UrYeUyKPOll8d9YkXcQ==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n\t\t\t<script src=\"https://cdnjs.cloudflare.com/ajax/libs/scriptaculous/1.9.0/dragdrop.min.js\" integrity=\"sha512-6yBI4A/TPWV555IYzpAmgIKoX6mrxckNc1ccDtfistI1r/tEerHSiWE9+Trt0VjFEYBWhmMqHrSHNS1Epi+R7w==\" crossorigin=\"anonymous\" referrerpolicy=\"no-referrer\"></script>\n\n\n\t\t\t<script type=\"text/javascript\" language=\"javascript\" src=\"/js/symbolpicker.js\"></script>\n\t\t\t<script type=\"text/javascript\" language=\"javascript\" src=\"/js/shared.js\"></script>\n\t\t\t\t<script type=\"text/javascript\" src=\"https://cdnjs.cloudflare.com/polyfill/v3/polyfill.min.js?features=Array.prototype.includes,default,fetch,Promise,URLSearchParams&flags=gated,always&ua=chrome/50\"></script>\n\t\t\t\t<script type=\"text/javascript\" language=\"javascript\" src=\"//www.agricharts.com/marketdata/quotelib.js\"></script>\t\t\t\t\t\t<script type=\"text/javascript\" src=\"/js/cmdty-news.js\"></script>\n        <script type=\"text/javascript\" src=\"/js/accessibility-fixes.js\"></script>\t\t<link rel=\"stylesheet\" href=\"/sitetemplates/default.css\" type=\"text/css\" />\n\t\t<link rel=\"stylesheet\" href=\"/css/sitesettings.php\" type=\"text/css\" />\n\t\t<link rel=\"stylesheet\" type=\"text/css\" href=\"/css/cmdty-news.css\" />\n\t</head>\n\t<body>\n\t\t<div id=\"header\" class=\"header_color\" role=\"banner\">\n\t\t\t<table width=\"100%\" cellpadding=\"0\" cellspacing=\"0\" border=\"0\">\n\t\t\t\t<tr>\n\t\t\t\t\t<td>\n\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t\t<tr>\n\t\t\t\t\t<td align=\"right\">\n<!-- removed login / user info\n\t\t\t\t\t\t \t\t\t\t\t\t\tNot signed in - <a href=\"/account/login.php\">Sign In</a>\n\t\t\t\t\t\t -->\t\t\t\t\t</td>\n\t\t\t\t</tr>\n\t\t\t</table>\n\t\t</div>\n\t\t<div id=\"menubar\" class=\"menubar_color\" role=\"navigation\">\n\t\t\t\t\t\t\t<div style=\"padding: 4px; text-align: right;\">Friday, November 13, 2026</div>\n\t\t\t\t\t</div>\n\t\t\t\t\t<div id=\"content\" class=\"content_color\" role=\"main\">\n\t\t\t\t<center>\n<div class=\"topad\">\n</div>\n</center>\n\n<script type=\"text/javascript\" language=\"javascript\" src=\"//www.agricharts.com/marketdata/jsquote.php?varname=quotes&symbols=ZCZ26,ZCH27,ZCK27,ZCN27,ZSF27&fields=name,month,last&user=&pass=&settle=0&exchsyms=&currencyconv=&display_ice=&ice_exchanges=&displayType=bids\"></script>\n<script language=\"javascript\" nonce=\"ac-sites-inline-js\">\n\n\tdisplay = '64';\n\tvar quote = null;\n\n\tfunction writeMonthHdr(month, quote, eod) {\n\t\t//if (typeof(quote) == 'undefined')\n\t\t\t//return;\n\n\t\tvar unitvalue = quote.exchange == 'WCE' ? 100 : 1;\n\t\tprice = quote.last * unitvalue;\n\t\tdocument.write('<th');\n\t\tif (quote && (quote.mode == 'r' || quote.mode == 's'))\n\t\t\tdocument.write(' class=\"realtime text-center\"');\n\t\telse\n\t\t\tdocument.write(' class=\"text-center\"');\n\t\tdocument.write(' align=\"center\">');\n\t\tdocument.write('<i>' + month + '</i><br />');\n\t\tif (quote && (['2', '3', '4'].includes(quote.unitcode)  || quote.symbol.substring(0,2) == 'KG'  || quote.symbol.substring(0,2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR'))\n\t\t\tdocument.write('$'+parseFloat(price).toFixed(2));\n\t\telse\n\t\t\tdocument.write('$'+(parseFloat(price)/100).toFixed(2));\n\t\tif (!eod) {\n\t\t\tdocument.write('<br />');\n\t\t\tif (quote && (['2', '3', '4'].includes(quote.unitcode)  || quote.symbol.substring(0,2) == 'KG'  || quote.symbol.substring(0,2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR'))\n\t\t\t\tvar change = ((parseFloat(quote.change.replace(/^\\+/, ''))*unitvalue)).toFixed(2);\n\t\t\telse\n\t\t\t\tvar change = ((parseFloat(quote.change.replace(/^\\+/, ''))*unitvalue)/100).toFixed(2);\n\t\t\tif (change == 0)\n\t\t\t\tdocument.write('<span class=\"change_none\"><small>');\n\t\t\telse {\n\t\t\t\tdocument.write('<span class=\"change_'+quote.changedir+'\"><small>');\n\t\t\t\tif (quote.pchange.substring(0,1) != '0')\n\t\t\t\t\tdocument.write(quote.pchange.substring(0,1));\n\t\t\t}\n\t\t\tdocument.write('$' + change);\n\t\t\tdocument.write('</small></span>');\n\t\t}\n\t\tdocument.write('</th>');\n\t}\n\n\tfunction writeBidCell(basis, manual, rounding, incwt, weight, chartsym, currConv, quote) {\n\n\t\tvar decimalPlaces = basis.toString().substring(basis.toString().indexOf('.')+1).length;\n\t\tif (decimalPlaces < 2) {\n\t\t\tdecimalPlaces = 2;\n\t\t\tif (typeof(quote) == 'undefined') {\n\t\t\t\tbasis =  basis.toFixed(decimalPlaces);\n\t\t\t}\n\t\t}\n\n\t\tvar unitvalue = quote && quote.exchange == 'WCE' ? 100 : 1;\n\n\t\tvar basis_decimals = parseInt('2');\n\t\tif (basis_decimals == 0 || basis_decimals == '')\n\t\t\tbasis_decimals = 2;\n\t\tvar cashprice_decimals = parseInt('4');\n\t\tif (cashprice_decimals == 0 || cashprice_decimals == '')\n\t\t\tcashprice_decimals = 2;\n\n\t\tvar rounded = (typeof(quote) == \"undefined\") ? parseInt(basis.toString().replace('.', '')) : basis;\n\t\tif (!weight) weight = 56;\n\t\tvar realtime = false;\n\t\tif (!manual && quote.symbol) {\n\t\t\tvar realtime = quote && (quote.mode == 'r' || quote.mode == 's');\n\t\t\tvar price = quote.rawLast * unitvalue;\n\t\t\tif (quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR') {\n\t\t\t\tvar rounded = (parseFloat(price) + (basis/100));\n\t\t\t} else {\n\t\t\t\tvar rounded = (parseFloat(price) + basis);\n\t\t\t}\n\t\t\tif (currConv) {\n\t\t\t\trounded *= quote.exchangeRate;\n\t\t\t}\n\t\t}\n\t\tdocument.write('<td align=\"center\" class=\"gridbox text-center' + (realtime?' realtime_shade':'') + '\">');\n\t\t\t\t\tdocument.write('<a title=\"View Chart for ' + chartsym + '\" aria-label=\"View Chart for ' + chartsym + '\" href=\"/markets/cashchart.php?' + chartsym + '\">');\n\t\t\tdocument.write('$');\n\t\t\tif (incwt)\n\t\t\t\trounded = rounded * (100 / weight);\n\t\t\tvar remainder = rounded - Math.floor(rounded);\n\t\t\tif (rounding > -1) {\n\t\t\t\tif(quote && (['2', '3', '4'].includes(quote.unitcode)  || quote.symbol.substring(0,2) == 'KG' || quote.symbol.substring(0,2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR'))\n\t\t\t\t\tdocument.write(rounded.toFixed(cashprice_decimals));\n\t\t\t\telse {\n\t\t\t\t\trounded = remainder >= rounding ? Math.ceil(rounded) : Math.floor(rounded);\n\t\t\t\t\tdocument.write((rounded/100).toFixed(cashprice_decimals));\n\t\t\t\t}\n\t\t\t} else {\n\t\t\t\tif (rounded - Math.floor(rounded) > 0)\n\t\t\t\t\tif(quote && (['2', '3', '4'].includes(quote.unitcode)  || quote.symbol.substring(0,2) == 'KG' || quote.symbol.substring(0,2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR'))\n\t\t\t\t\t\tdocument.write(rounded.toFixed(cashprice_decimals));\n\t\t\t\t\telse\n\t\t\t\t\t\tdocument.write((rounded/100).toFixed(cashprice_decimals));\n\t\t\t\telse\n\t\t\t\t\tif(quote && (['2', '3', '4'].includes(quote.unitcode)  || quote.symbol.substring(0,2) == 'KG' || quote.symbol.substring(0,2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR'))\n\t\t\t\t\t\tdocument.write(rounded.toFixed(cashprice_decimals));\n\t\t\t\t\telse\n\t\t\t\t\t\tdocument.write((rounded/100).toFixed(cashprice_decimals));\n\t\t\t}\n\t\t\tdocument.write('</a>');\n\t\t\t\t\t\t\t\t\t\tdocument.write('</td>');\n\t}\n\n</script>\n\t<!--//Ravish- Added customized_announcement field to the list below, to display the field as part of cashbid configuration for the clients to display a customized announcement on top the cashbids.-->\n\t\t\t<div style=\"float:right;\">\n\t\t<form action=\"/markets/cash.php\" method=\"get\" style=\"display: inline;\">\n\t\t\t<label for=\"locationFilter\">Location:</label>\n\t\t\t<!--<select tabindex=\"1\" id=\"locationFilter\" name=\"location_filter\" onchange=\"this.form.submit()\">-->\n\t\t\t<select id=\"locationFilter\" name=\"location_filter\" onchange=\"this.form.submit()\">\n