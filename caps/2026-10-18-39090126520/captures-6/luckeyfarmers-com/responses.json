inWetBulbGlobeTemp\":46,\"maxWetBulbGlobeTemp\":62,\"avgWetBulbGlobeTemp\":50,\"evapotranspiration\":0.08,\"growingDegreeDay\":8,\"minutesOfSunshine\":634,\"soil\":null},{\"stationId\":\"KTDZ\",\"latitude\":41.564722,\"longitude\":-83.482222,\"date\":\"2026-10-21\",\"timeZone\":\"America/New_York\",\"sunrise\":\"2026-10-21T11:53:00+00:00\",\"sunset\":\"2026-10-21T22:43:00+00:00\",\"weatherCode\":1,\"weatherDescription\":\"Partly Cloudy\",\"precipitation\":[{\"type\":\"SNOW\",\"amount\":0,\"probability\":0},{\"type\":\"RAIN\",\"amount\":0,\"probability\":0},{\"type\":\"FREEZING RAIN\",\"amount\":0,\"probability\":0}],\"avgDewPoint\":46,\"avgRelativeHumidity\":68,\"avgPressure\":\"29.92\",\"minTemperature\":44,\"maxTemperature\":65,\"avgTemperature\":55,\"avgWetBulbTemp\":50,\"minHeatIndex\":44,\"maxHeatIndex\":65,\"avgHeatIndex\":53,\"minWindChill\":44,\"maxWindChill\":65,\"avgWindChill\":53,\"minFeelsLike\":44,\"maxFeelsLike\":65,\"avgFeelsLike\":53,\"maxWindSpeed\":5,\"avgWindSpeed\":3,\"windDirection\":45,\"cornHeatUnit\":13,\"minWetBulbGlobeTemp\":48,\"maxWetBulbGlobeTemp\":62,\"avgWetBulbGlobeTemp\":50,\"evapotranspiration\":0.07,\"growingDegreeDay\":7.5,\"minutesOfSunshine\":533,\"soil\":null}]"
