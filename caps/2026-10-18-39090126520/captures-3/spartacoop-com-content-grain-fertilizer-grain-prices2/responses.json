  "body": "<!DOCTYPE html><!--[if lt IE 7]>      <html class=\"no-js lt-ie9 lt-ie8 lt-ie7\"> <![endif]-->\n<!--[if IE 7]>         <html class=\"no-js lt-ie9 lt-ie8\"> <![endif]-->\n<!--[if IE 8]>         <html class=\"no-js lt-ie9\"> <![endif]-->\n<!--[if gt IE 8]><!-->\n<html class=\"no-js\"> <!--<![endif]-->\n\n<HEAD prefix=\"og: https://ogp.me/ns# article: https://ogp.me/ns/article# fb: https://ogp.me/ns/fb# \">\n    <meta charset=\"utf-8\">\n    <meta http-equiv=\"Content-Type\" content=\"text/html; charset=UTF-8\" />\n    <meta http-equiv=\"X-UA-Compatible\" content=\"IE=edge,chrome=1\">\n    <meta name=\"viewport\" content=\"width=device-width\">\n    <TITLE>Grain Prices - Sparta Co-op Services - Your Local Western Wisconsin Coop for Grain Prices, Fertilizer, LP Services, Tires, Feed Mill Services, Motorsports, and Multi Fuel Stoves located in Sparta, Wisconsin</TITLE>\n            <META NAME=\"title\" CONTENT=\"Grain Prices\">\n                    <META NAME=\"description\" CONTENT=\"Grain Prices at the Sparta Coop in Sparta Wisconsin\">\n    \n    <meta property='og:title' content='Grain Prices' /> \n<meta property='article:published_time' content='2014-10-28' /> \n<meta property='article:modified_time' content='2026-09-29' /> \n<meta property='og:image' content='http://spartacoop.com/images/some-image.png' /> \n<meta property='og:site_name' content='Site name' /> \n<meta property='fb:admins' content='525592664' /> \n<meta property='og:type' content='article' /> \n<meta property='og:description' content='Grain Prices at the Sparta Coop in Sparta Wisconsin' /> \n    <link rel=\"stylesheet\" href=\"/css/foundation.css\" />\n    <link rel=\"stylesheet\" href=\"/css/app.css\" />\n    <link rel=\"stylesheet\" href=\"/css/cart.css\" />\n    <script src=\"/js/vendor/modernizr.js\"></script>\n    <script src=\"https://ajax.googleapis.com/ajax/libs/jquery/1.11.1/jquery.min.js\"></script>\n    <script src=\"https://ajax.googleapis.com/ajax/libs/jqueryui/1.12.1/jquery-