sive = false;\n\t\t\t\tvar responsiveAlign = (iResponsive) ? '':'right';\n\t\tif (typeof(quote) == 'undefined')\n\t\t\treturn;\n\n\t\tvar price = 0;\n\t\tvar futures = 0;\n\n\t\tvar basis_decimals = parseInt('');\n\t\tif (basis_decimals == 0 || basis_decimals == '' || typeof(basis_decimals) == 'undefined' || isNaN(basis_decimals))\n\t\t\tbasis_decimals = 0;\n\n\t\tvar cashprice_decimals = parseInt('2');\n\t\tif (cashprice_decimals == 0 || cashprice_decimals == '' || typeof(cashprice_decimals) == 'undefined' || isNaN(cashprice_decimals))\n\t\t\tcashprice_decimals = 2;\n\t\t\n\t\tif (!weight) weight = 56;\n\t\tif (!manual && quote) {\n\t\t\tfutures = quote.last;\n\t\t\tprice = quote.rawLast * (quote.exchange == 'WCE' ? 100 : 1);\n\t\t}\n\t\tdocument.write('<tr class=\"'+rowclass+'\">');\n\t\t\t\t\t\t\t\t\tdocument.write('<td valign=\"top\">' + name + '</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tdocument.write('<td valign=\"top\">' + start + '</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tdocument.write('<td valign=\"top\">' + end + '</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tdocument.write('<td valign=\"top\">');\n\t\t\t\tif (manual || !quote.symbol)\n\t\t\t\t\tdocument.write('&nbsp;');\n\t\t\t\telse {\n\t\t\t\t\tif (exchDisplayType == 'CASH_ONLY') {\n\t\t\t\t\t\tdocument.write('-');\n\t\t\t\t\t} else {\n\t\t\t\t\t\tdocument.write('<a href=\"/markets/chart.php?symbol=' + quote.symbol + '&title=' + escape(quote.name + ' ' + quote.month + ' Chart') + '\" aria-label=\"Chart for ' + quote.name + ' - ' + quote.symbol + '\">' + quote.month + '</a>');\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdocument.write('</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tif (quote && (quote.mode == 'r' || quote.mode == 's'))\n\t\t\t\t\tdocument.write('<td valign=\"top\" class=\"realtime_shade text-right\" align=\"' + responsiveAlign + '\">');\n\t\t\t\telse\n\t\t\t\t\tdocument.write('<td  valign=\"top\" align=\"' + responsiveAlign + '\">');\n\t\t\t\tif (manual || !quote.symbol)\n\t\t\t\t\tdocument.write('&nbsp;');\n\t\t\t\telse {\n\t\t\t\t\tif (exchDisplayType == 'CASH_ONLY') {\n\t\t\t\t\t\tdocument.write('-');\n\t\t\t\t\t} else {\n\t\t\t\t\t\tif (displayOrigPrice)\n\t\t\t\t\t\t\tdocument.write(quotelib.FormatPrice(quote.rawLast, quote.basecode, display));\n\t\t\t\t\t\telse {\n\t\t\t\t\t\t\tif (currConv) {\n\t\t\t\t\t\t\t\tdocument.write(quotelib.FormatPrice(futures, quote.basecode, display));\n\t\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\t\tdocument.write(quotelib.FormatPrice(quote.rawLast, quote.basecode, display));\n\t\t\t\t\t\t\t}\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdocument.write('</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tdocument.write('<td  valign=\"top\" align=\"' + responsiveAlign + '\">');\n\t\t\t\tif (manual || !quote.symbol)\n\t\t\t\t\tdocument.write('&nbsp;');\n\t\t\t\telse {\n\t\t\t\t\tif (exchDisplayType == 'CASH_ONLY') {\n\t\t\t\t\t\tdocument.write('-');\n\t\t\t\t\t} else {\n\t\t\t\t\t\tif (quote.change < 0)\n\t\t\t\t\t\t\tdocument.write('<span class=\"change_down\">');\n\t\t\t\t\t\telse if (quote.change > 0)\n\t\t\t\t\t\t\tdocument.write('<span class=\"change_up\">+');\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\tdocument.write('<span class=\"change_none\">');\n\t\t\t\t\t\tdocument.write(quotelib.FormatPrice(quote.change, quote.basecode, display));\n\t\t\t\t\t\tdocument.write('</span>');\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdocument.write('</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tif (quote && (quote.mode == 'r' || quote.mode == 's'))\n\t\t\t\t\tdocument.write('<td valign=\"top\" class=\"realtime_shade text-right\" align=\"' + responsiveAlign + '\">');\n\t\t\t\telse\n\t\t\t\t\tdocument.write('<td  valign=\"top\" align=\"' + responsiveAlign + '\">');\n\t\t\t\tif (manual)\n\t\t\t\t\tdocument.write('&nbsp;');\n\t\t\t\telse{\n\t\t\t\t\tif (exchDisplayType == 'CASH_ONLY') {\n\t\t\t\t\t\tdocument.write('-');\n\t\t\t\t\t} else {\n\t\t\t\t\t\tif (basisInActualCents)\n\t\t\t\t\t\t\tdocument.write((basis/100).toFixed(basis_decimals));\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\tdocument.write(basis.toFixed(basis_decimals));\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdocument.write('</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tif (quote && (quote.mode == 'r' || quote.mode == 's'))\n\t\t\t\t\tdocument.write('<td valign=\"top\" class=\"realtime_shade text-right\" align=\"' + responsiveAlign + '\">');\n\t\t\t\telse\n\t\t\t\t\tdocument.write('<td  valign=\"top\" align=\"' + responsiveAlign + '\">');\n\t\t\t\tif (manual || quote.symbol) {\n\t\t\t\t\tif (exchDisplayType == 'CASH_ONLY' && quote.symbol) {\n\t\t\t\t\t\tdocument.write('$');\n\t\t\t\t\t} else {\n\t\t\t\t\t\tdocument.write('<a href=\"/markets/cashchart.php?' + chartsym + '\" aria-label=\"Cash price chart for ' + chartsym + '\">$');\n\t\t\t\t\t}\n\t\t\t\t\tvar rounded = basis;\n\n\t\t\t\t\tif (!manual) {\n\t\t\t\t\t\tif (quote && quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR' || quote.symbol.substring(0,2) == 'ZM') {\n\t\t\t\t\t\t\trounded = (parseFloat(price) + (basis/100));\n\t\t\t\t\t\t} else {\n\t\t\t\t\t\t\trounded = (parseFloat(price) + basis);\n\t\t\t\t\t\t}\n\n\t\t\t\t\t\tif (currConv) {\n\t\t\t\t\t\t\trounded *= quote.exchangeRate;\n\t\t\t\t\t\t}\n\t\t\t\t\t}\n\t\t\t\t\tvar remainder = rounded - Math.floor(rounded);\n\t\t\t\t\tif (rounding > -1) {\n\t\t\t\t\t\tif(quote && (quote.unitcode == 3 || quote.symbol.substring(0,2) == 'KG' || quote.symbol.substring(0, 2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR' || quote.symbol.substring(0,2) == 'ZM'))\n\t\t\t\t\t\t\tdocument.write(rounded.toFixed(cashprice_decimals));\n\t\t\t\t\t\telse {\n\t\t\t\t\t\t\trounded = remainder >= rounding ? Math.ceil(rounded) : Math.floor(rounded);\n\t\t\t\t\t\t\tdocument.write((rounded/100).toFixed(cashprice_decimals));\n\t\t\t\t\t\t}\n\n\t\t\t\t\t} else {\n\t\t\t\t\t\tif (rounded - Math.floor(rounded) > 0)\n\t\t\t\t\t\t\tif(quote && (quote.unitcode == 3 || quote.symbol.substring(0,2) == 'KG' || quote.symbol.substring(0, 2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR' || quote.symbol.substring(0,2) == 'ZM'))\n\t\t\t\t\t\t\t\tdocument.write(rounded.toFixed(cashprice_decimals));\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\tdocument.write((rounded/100).toFixed(cashprice_decimals));\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\tif(quote && (quote.unitcode == 3 || quote.symbol.substring(0,2) == 'KG' || quote.symbol.substring(0, 2) == 'ZM' || quote.symbol.substring(0,2) == 'MW' || quote.symbol.substring(0,2) == 'ZR' || quote.symbol.substring(0,2) == 'ZM'))\n\t\t\t\t\t\t\t\tdocument.write(rounded.toFixed(cashprice_decimals));\n\t\t\t\t\t\t\telse\n\t\t\t\t\t\t\t\tdocument.write((rounded/100).toFixed(cashprice_decimals));\n\t\t\t\t\t}\n\t\t\t\t} else {\n\t\t\t\t\tdocument.write('&nbsp;');\n\t\t\t\t}\n\t\t\t\tif (exchDisplayType != 'CASH_ONLY') {\n\t\t\t\t\tdocument.write('</a>');\n\t\t\t\t}\n\t\t\t\tdocument.write('</td>');\n\t\t\t\t\t\t\t\t\t\t\t\tvar value;\n\t\t\t\tif(quote && quote.symbol.substring(0,2) == 'MW')\n\t\t\t\t\tdisplay = 'DECIMAL';\n\t\t\t\telse\n\t\t\t\t\tdisplay = '64';\n\n\t\t\t\tif (quote && quote.settlement){\n\t\t\t\t\tsettlement = quotelib.FormatPrice(quote.settlement, quote.basecode, display);\n\t\t\t\t}\n\t\t\t\tif (settlement && settlement != null)\n\t\t\t\t\tvalue = String(settlement);\n\t\t\t\telse\n\t\t\t\t\tvalue = null;\n\n\t\t\t\tvar formattedValue;\n\n\t\t\t\tif (exchDisplayType == 'CASH_ONLY') {\n\t\t\t\t\t\tformattedValue = '-';\n\t\t\t\t\t} else {\n\t\t\t\t\tif (value && value != null) {\n\t\t\t\t\t\tif (value.indexOf('-') == -1)\n\t\t\t\t\t\t\tformattedValue = quotelib.FormatPrice(settlement, quote.basecode, display);\n\t\t\t\t\t\telse\n\t\t\t\t\t\t\tformattedValue = settlement;\n\t\t\t\t\t} else {\n\t\t\t\t\t\tformattedValue = '0-0';\n\t\t\t\t\t}\n\t\t\t\t}\n\t\t\t\tdocument.write('<td  valign=\"top\" align=\"' + responsiveAlign + '\">' + formattedValue + '</td>');\n\t\t\t<!--***********************************-->\n\t\t\t\t\t\t\t\t\t\t\t\tdocument.write('</tr>');\n\t}\n\n</script>\n\t<?!--//Ravish- Added customized_announcement